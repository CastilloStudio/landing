---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Logo from '../../components/Logo.astro';
import Footer from '../../components/Footer.astro';
import { SITE } from '../../config';

export async function getStaticPaths() {
  const casos = await getCollection('casos');
  return casos.map((caso) => ({ params: { id: caso.id }, props: { caso } }));
}

const { caso } = Astro.props;
const { Content } = await render(caso);
const inicio = import.meta.env.BASE_URL;
const ruta = (r: string) => `${inicio}/${r}`.replace(/\/{2,}/g, '/');

const titulo = `${caso.data.nombre} — ${caso.data.titular} | ${SITE.nombre}`;
const descripcion = caso.data.descripcion ?? caso.data.resumen;
const url = new URL(Astro.url.pathname, Astro.site).toString();

// La tarjeta del enlace, recortada a 1200x630 al compilar.
const compartir = caso.data.compartir
  ? await getImage({ src: caso.data.compartir, width: 1200, height: 630, fit: 'cover', format: 'jpg' })
  : undefined;

const datos = [
  {
    '@type': 'WebPage',
    '@id': `${url}#pagina`,
    url,
    name: titulo,
    description: descripcion,
    inLanguage: 'es-ES',
    isPartOf: { '@id': `${Astro.site}#sitio` },
    publisher: { '@id': `${Astro.site}#organizacion` },
    breadcrumb: { '@id': `${url}#miga` },
    about: {
      '@type': 'CreativeWork',
      name: caso.data.nombre,
      description: caso.data.resumen,
      creator: { '@id': `${Astro.site}#organizacion` },
      ...(caso.data.web ? { url: caso.data.web } : {}),
    },
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${url}#miga`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.nombre, item: Astro.site?.toString() },
      { '@type': 'ListItem', position: 2, name: 'Casos', item: new URL('#casos', Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: caso.data.nombre, item: url },
    ],
  },
];
---

<Base
  title={titulo}
  description={descripcion}
  tipo="article"
  imagen={compartir && { src: compartir.src, alt: `${caso.data.nombre}: ${caso.data.titular}` }}
  datos={datos}
>
  <header class="bg-navy">
    <div class="mx-auto flex max-w-4xl items-center justify-between px-6 py-6">
      <a href={inicio} aria-label={SITE.nombre}>
        <Logo name="horizontal-blanco" acento class="h-9 w-auto" />
      </a>
      <a href={`${inicio}#casos`} class="text-sm text-grey transition-colors hover:text-bone">
        ← Todos los casos
      </a>
    </div>
  </header>

  <main id="contenido">
    <div class="bg-navy pb-20 text-bone">
      <div class="mx-auto max-w-4xl px-6 pt-10">
        <Image
          src={caso.data.icono}
          alt=""
          width={160}
          height={160}
          class="mb-8 size-20 rounded-2xl ring-1 ring-white/10"
        />
        <p class="eyebrow text-blue-soft">{caso.data.sector}</p>
        <h1 class="titular mt-6 text-4xl sm:text-6xl">{caso.data.nombre}</h1>
        <p class="titular mt-6 max-w-2xl text-xl text-grey sm:text-2xl">
          {caso.data.titular}
        </p>
      </div>
    </div>

    <div class="mx-auto max-w-4xl px-6">
      <dl class="-mt-12 grid gap-px overflow-hidden rounded-2xl bg-grey/60 shadow-sm sm:grid-cols-3">
        {
          caso.data.hitos.map((hito) => (
            <div class="bg-white p-6 sm:p-8">
              <dt class="font-display text-3xl font-light text-blue-ink">{hito.dato}</dt>
              <dd class="mt-2 text-sm leading-relaxed text-slate-600">{hito.pie}</dd>
            </div>
          ))
        }
      </dl>

      <div class="py-16">
        <p class="text-lg leading-relaxed text-slate-700">{caso.data.resumen}</p>

        <div
          class="mt-10 space-y-5 leading-relaxed text-slate-600 [&>p]:text-[1.0625rem]"
        >
          <Content />
        </div>

        {
          caso.data.funciones && (
            <section class="mt-16" aria-labelledby="funciones">
              <h2 id="funciones" class="titular text-2xl sm:text-3xl">
                Lo que trae
              </h2>
              <ul class="mt-8 grid gap-4 sm:grid-cols-2">
                {caso.data.funciones.map((f) => (
                  <li class="rounded-2xl border border-grey/60 bg-white p-6">
                    <h3 class="font-display font-medium text-navy">{f.titulo}</h3>
                    <p class="mt-2 text-sm leading-relaxed text-slate-600">{f.texto}</p>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          caso.data.capturas && (
            <section class="mt-16" aria-labelledby="capturas">
              <h2 id="capturas" class="titular text-2xl sm:text-3xl">
                Así se ve
              </h2>
              <div class="mt-8 space-y-12">
                {caso.data.capturas.map((c, i) => (
                  <figure class={c.movil ? 'mx-auto max-w-xs' : ''}>
                    <Image
                      src={c.imagen}
                      alt={c.alt}
                      widths={c.movil ? [320, 640] : [480, 896, 1600]}
                      sizes={c.movil ? '320px' : '(min-width: 56rem) 52rem, 100vw'}
                      loading={i === 0 ? 'eager' : 'lazy'}
                      class={`w-full border border-grey/60 bg-white shadow-sm ${c.movil ? 'rounded-3xl' : 'rounded-xl'}`}
                    />
                    <figcaption class="mt-3 text-center text-sm text-slate-600">
                      {c.pie}
                    </figcaption>
                  </figure>
                ))}
              </div>
            </section>
          )
        }

        {
          caso.data.manual && (
            <div class="mt-16 flex flex-col gap-6 rounded-2xl bg-navy p-8 text-bone sm:flex-row sm:items-center sm:justify-between">
              <div>
                <p class="eyebrow text-blue-soft">Manual</p>
                <p class="mt-3 max-w-md leading-relaxed text-grey">
                  Lo que hace cada botón del panel, en el orden en que se usa.
                  Público: se puede leer antes de decidir.
                </p>
              </div>
              <a
                href={ruta(caso.data.manual.href)}
                class="shrink-0 rounded-full bg-bone px-7 py-3.5 text-center font-medium text-navy transition-colors hover:bg-white"
              >
                {caso.data.manual.texto}
              </a>
            </div>
          )
        }

        <div class="mt-12 rounded-2xl border border-grey/60 bg-bone p-8">
          <p class="eyebrow text-slate-500">Qué demuestra</p>
          <p class="mt-3 leading-relaxed text-navy">{caso.data.aprendizaje}</p>
        </div>

        <div class="mt-14 flex flex-wrap gap-4 border-t border-grey/60 pt-10">
          {
            caso.data.web && (
              <a
                href={caso.data.web}
                rel="noopener"
                class="rounded-full bg-blue-ink px-7 py-3.5 font-medium text-bone transition-colors hover:bg-blue"
              >
                {caso.data.webTexto}
              </a>
            )
          }
          <a
            href={`${inicio}#contacto`}
            class="rounded-full border border-grey px-7 py-3.5 transition-colors hover:bg-white"
          >
            Cuéntanos el tuyo
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Base>
