---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Logo from '../../components/Logo.astro';
import Footer from '../../components/Footer.astro';
import { SITE } from '../../config';

export async function getStaticPaths() {
  const casos = await getCollection('casos');
  return casos.map((caso) => ({ params: { id: caso.id }, props: { caso } }));
}

const { caso } = Astro.props;
const { Content } = await render(caso);
const inicio = import.meta.env.BASE_URL;
---

<Base
  title={`${caso.data.nombre} — ${caso.data.titular} | ${SITE.nombre}`}
  description={caso.data.resumen}
>
  <header class="bg-navy">
    <div class="mx-auto flex max-w-4xl items-center justify-between px-6 py-6">
      <a href={inicio} aria-label={SITE.nombre}>
        <Logo name="horizontal-blanco" acento class="h-9 w-auto" />
      </a>
      <a href={`${inicio}#casos`} class="text-sm text-grey transition-colors hover:text-bone">
        ← Todos los casos
      </a>
    </div>
  </header>

  <main id="contenido">
    <div class="bg-navy pb-20 text-bone">
      <div class="mx-auto max-w-4xl px-6 pt-10">
        <p class="eyebrow text-blue-soft">{caso.data.sector}</p>
        <h1 class="titular mt-6 text-4xl sm:text-6xl">{caso.data.nombre}</h1>
        <p class="titular mt-6 max-w-2xl text-xl text-grey sm:text-2xl">
          {caso.data.titular}
        </p>
      </div>
    </div>

    <div class="mx-auto max-w-4xl px-6">
      <dl class="-mt-12 grid gap-px overflow-hidden rounded-2xl bg-grey/60 shadow-sm sm:grid-cols-3">
        {
          caso.data.hitos.map((hito) => (
            <div class="bg-white p-6 sm:p-8">
              <dt class="font-display text-3xl font-light text-blue-ink">{hito.dato}</dt>
              <dd class="mt-2 text-sm leading-relaxed text-slate-600">{hito.pie}</dd>
            </div>
          ))
        }
      </dl>

      <div class="py-16">
        <p class="text-lg leading-relaxed text-slate-700">{caso.data.resumen}</p>

        <div
          class="mt-10 space-y-5 leading-relaxed text-slate-600 [&>p]:text-[1.0625rem]"
        >
          <Content />
        </div>

        <div class="mt-12 rounded-2xl border border-grey/60 bg-bone p-8">
          <p class="eyebrow text-slate-500">Qué demuestra</p>
          <p class="mt-3 leading-relaxed text-navy">{caso.data.aprendizaje}</p>
        </div>

        <div class="mt-12">
          <p class="eyebrow text-slate-500">Con qué está hecho</p>
          <ul class="mt-4 flex flex-wrap gap-2">
            {
              caso.data.stack.map((t) => (
                <li class="rounded-full bg-white px-3 py-1 text-xs text-slate-600 ring-1 ring-grey/70 ring-inset">
                  {t}
                </li>
              ))
            }
          </ul>
        </div>

        <div class="mt-14 flex flex-wrap gap-4 border-t border-grey/60 pt-10">
          {
            caso.data.web && (
              <a
                href={caso.data.web}
                rel="noopener"
                class="rounded-full bg-blue-ink px-7 py-3.5 font-medium text-bone transition-colors hover:bg-blue"
              >
                {caso.data.webTexto}
              </a>
            )
          }
          <a
            href={`${inicio}#contacto`}
            class="rounded-full border border-grey px-7 py-3.5 transition-colors hover:bg-white"
          >
            Cuéntanos el tuyo
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</Base>
