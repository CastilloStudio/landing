---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const proyectos = (await getCollection('casos'))
  .filter((caso) => caso.data.estado === 'en-desarrollo')
  .sort((a, b) => a.data.orden - b.data.orden);
const inicio = import.meta.env.BASE_URL;
---

{proyectos.length > 0 && (
  <section id="en-desarrollo" aria-label="Productos en desarrollo" class="scroll-mt-20 border-y border-grey/60 bg-bone py-20 sm:py-28">
    <div class="mx-auto max-w-6xl space-y-12 px-6">
      {proyectos.map((proyecto) => (
        <article class="grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-20">
          <div>
            <p class="eyebrow text-blue-ink">Lo próximo de Castillo Studio</p>
            <div class="mt-7 flex flex-wrap items-center gap-4">
              <Image src={proyecto.data.icono} alt="" width={64} height={64} class="size-12 rounded-xl" />
              <h2 class="font-display text-4xl font-medium tracking-tight text-navy sm:text-5xl">{proyecto.data.nombre}</h2>
              <span class="rounded-full border border-slate-300 bg-white px-3 py-1.5 text-xs font-medium text-slate-700">En desarrollo</span>
            </div>
            <p class="titular mt-7 text-3xl leading-tight text-navy sm:text-4xl">{proyecto.data.titular}</p>
            <p class="mt-6 max-w-xl leading-relaxed text-slate-600">{proyecto.data.resumen}</p>
            <div class="mt-9 flex flex-wrap items-center gap-5">
              <a href={`${inicio}casos/${proyecto.id}/`.replace(/\/{2,}/g, '/')} class="inline-flex items-center gap-3 rounded-full bg-blue-ink px-7 py-3.5 text-sm font-medium text-white transition-colors hover:bg-navy">
                Descubrir {proyecto.data.nombre}<span aria-hidden="true">→</span>
              </a>
              <a href={`${inicio}#contacto`} class="text-sm font-medium text-navy underline decoration-slate-400 underline-offset-4 hover:decoration-navy">Hablemos de tu comercio</a>
            </div>
            <p class="mt-5 text-sm text-slate-600">Primer vistazo al proyecto. Todavía no disponible para contratar.</p>
          </div>
          {proyecto.data.capturas?.[0] && (
            <figure class="relative overflow-hidden rounded-3xl border border-grey/60 bg-white p-7 sm:p-10">
              <div class="mb-7 flex items-center justify-between gap-4 text-xs text-slate-600">
                <span class="eyebrow text-slate-600">Un pequeño adelanto</span>
                <span>01 / Tarjeta</span>
              </div>
              <Image src={proyecto.data.capturas[0].imagen} alt={proyecto.data.capturas[0].alt} widths={[346, 692]} sizes="(min-width: 64rem) 380px, 80vw" class="mx-auto w-full max-w-sm rounded-2xl" />
              <figcaption class="mt-6 text-sm leading-relaxed text-slate-600">{proyecto.data.capturas[0].pie}</figcaption>
            </figure>
          )}
        </article>
      ))}
    </div>
  </section>
)}
