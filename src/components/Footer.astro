---
import Logo from './Logo.astro';
import { SITE } from '../config';

const anio = new Date().getFullYear();
---

<footer class="bg-navy text-grey">
  <div class="mx-auto max-w-6xl px-6 py-12">
    <div class="flex flex-col gap-8 border-t border-white/10 pt-10 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <Logo name="horizontal-blanco" acento class="h-9 w-auto" />
        <p class="mt-4 text-sm">{SITE.claim}</p>
      </div>

      <div class="flex flex-col gap-2 text-sm sm:items-end">
        <a href={`mailto:${SITE.email}`} class="hover:text-bone">{SITE.email}</a>
        <a href={SITE.github} rel="noopener" class="hover:text-bone">GitHub</a>
        <p class="text-slate-400">© {anio} {SITE.nombre}</p>
      </div>
    </div>
  </div>
</footer>
