---
import { SITE } from '../config';

const asunto = encodeURIComponent('Proyecto — Castillo Studio');
---

<section id="contacto" class="scroll-mt-20 bg-bone py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-6">
    <div class="grid items-start gap-12 lg:grid-cols-2">
      <div>
        <p class="eyebrow text-blue-ink">Contacto</p>
        <h2 class="titular mt-5 text-3xl sm:text-5xl">
          Cuéntanos qué quieres resolver.
        </h2>
        <p class="mt-6 max-w-xl leading-relaxed text-slate-600">
          Escríbenos con dos líneas sobre el problema. Respondemos diciendo si
          es algo que sepamos hacer bien, y si no lo es, lo decimos también.
        </p>
      </div>

      <div class="rounded-2xl border border-grey/60 bg-white p-8 sm:p-10">
        <p class="eyebrow text-slate-500">Escríbenos</p>

        <ul class="mt-6 space-y-5">
          {
            SITE.contactos.map((persona) => {
              // En pantallas estrechas la dirección no cabe entera: el <wbr>
              // ofrece la arroba como punto de corte antes que partir una palabra.
              const [buzon, dominio] = persona.email.split('@');
              return (
                <li class="border-t border-grey/60 pt-5 first:border-0 first:pt-0">
                  <p class="font-display text-lg font-normal text-navy">{persona.nombre}</p>
                  <a
                    href={`mailto:${persona.email}?subject=${asunto}`}
                    class="group mt-1 block [overflow-wrap:anywhere] text-blue-ink hover:underline"
                  >
                    {buzon}
                    <wbr />
                    {`@${dominio}`}
                    <span
                      aria-hidden="true"
                      class="ml-2 inline-block transition-transform group-hover:translate-x-0.5"
                    >
                      →
                    </span>
                  </a>
                </li>
              );
            })
          }
        </ul>

        <p class="mt-8 border-t border-grey/60 pt-6 text-sm leading-relaxed text-slate-500">
          {SITE.frase}.
        </p>
      </div>
    </div>
  </div>
</section>
