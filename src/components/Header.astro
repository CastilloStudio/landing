---
import Logo from './Logo.astro';
import { SITE } from '../config';
---

<header class="absolute inset-x-0 top-0 z-30">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-6">
    <a href="#" class="shrink-0" aria-label={SITE.nombre}>
      <Logo name="horizontal-blanco" acento class="h-9 w-auto sm:h-10" />
    </a>

    <nav aria-label="Principal" class="hidden items-center gap-8 md:flex">
      {
        SITE.nav.map((item) => (
          <a
            href={item.href}
            class="text-sm text-grey transition-colors hover:text-bone"
          >
            {item.texto}
          </a>
        ))
      }
      <a
        href={`mailto:${SITE.email}`}
        class="rounded-full border border-grey/30 px-5 py-2 text-sm text-bone transition-colors hover:border-blue-ink hover:bg-blue-ink"
      >
        Hablemos
      </a>
    </nav>

    <a
      href="#contacto"
      class="rounded-full border border-grey/30 px-4 py-2 text-sm text-bone md:hidden"
    >
      Contacto
    </a>
  </div>
</header>
