---
import '../styles/global.css';
import { SITE } from '../config';
// Las dos tipografías de la marca, pedidas desde el principio: si llegan tarde,
// el texto se recoloca al cambiar de letra y la página «salta» (Lighthouse,
// desplazamiento de diseño). Son las mismas que importa global.css.
import montserrat from '@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url';
import inter from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** Las páginas de servicio (404) no deben indexarse. */
  noindex?: boolean;
  /** Imagen de la tarjeta del enlace, de 1200x630. Sin ella, la del estudio. */
  imagen?: { src: string; alt: string };
  /** «article» en lo que se lee (casos, manuales); «website» en la portada. */
  tipo?: 'website' | 'article';
  /** Nodos de datos estructurados propios de la página, además de los del sitio. */
  datos?: Record<string, unknown>[];
}

// La del estudio. Es también la de la portada, y la de sus datos
// estructurados en todas las páginas: cada página describe lo suyo, no al estudio.
const DESCRIPCION_ESTUDIO =
  'Estudio de desarrollo de software y hardware. Diseñamos, construimos y mantenemos productos completos: del sensor al panel, del código al instalador.';

const {
  title = 'Castillo Studio — Tecnología para un mundo real',
  description = DESCRIPCION_ESTUDIO,
  noindex = false,
  imagen,
  tipo = 'website',
  datos = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
// Los assets de public/ cuelgan de BASE_URL, que no siempre es la raíz.
const asset = (ruta: string) => `${import.meta.env.BASE_URL}/${ruta}`.replace(/\/{2,}/g, '/');
const og = new URL(imagen?.src ?? asset('og-image.png'), Astro.site);
const alt = imagen?.alt ?? `${SITE.nombre} — ${SITE.claim}`;
const ogTipo = /\.jpe?g$/i.test(og.pathname) ? 'image/jpeg' : 'image/png';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': `${Astro.site}#organizacion`,
      name: SITE.nombre,
      url: Astro.site?.toString(),
      logo: new URL(asset('icon-512.png'), Astro.site).toString(),
      image: og.toString(),
      slogan: SITE.claim,
      description: DESCRIPCION_ESTUDIO,
      email: SITE.email,
      sameAs: [SITE.github],
      founder: SITE.quien.fundadores.map((nombre) => ({ '@type': 'Person', name: nombre })),
      areaServed: { '@type': 'Country', name: 'España' },
      knowsAbout: [
        'Desarrollo de software a medida',
        'Aplicaciones web',
        'Aplicaciones de escritorio',
        'Internet de las cosas',
        'Firmware y electrónica',
      ],
    },
    {
      '@type': 'WebSite',
      '@id': `${Astro.site}#sitio`,
      url: Astro.site?.toString(),
      name: SITE.nombre,
      inLanguage: 'es-ES',
      publisher: { '@id': `${Astro.site}#organizacion` },
    },
    ...datos,
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preload" href={montserrat} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={inter} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonical} />
    <meta
      name="robots"
      content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large,max-snippet:-1'}
    />

    <link rel="icon" href={asset('favicon.ico')} sizes="32x32" />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
    <link rel="manifest" href={asset('manifest.json')} />
    <meta name="theme-color" content="#0F172A" />
    <meta name="apple-mobile-web-app-title" content={SITE.nombre} />

    {/* WhatsApp y Telegram solo pintan la tarjeta grande si la imagen lleva
        URL absoluta y dimensiones declaradas. */}
    <meta property="og:type" content={tipo} />
    <meta property="og:site_name" content={SITE.nombre} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:secure_url" content={og} />
    <meta property="og:image:type" content={ogTipo} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={alt} />
    <meta property="og:locale" content="es_ES" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <meta name="twitter:image:alt" content={alt} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded focus:bg-navy focus:px-4 focus:py-2 focus:text-bone"
    >
      Saltar al contenido
    </a>
    <slot />
  </body>
</html>
