---
import Base from './Base.astro';
import Logo from '../components/Logo.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';

interface Props {
  titulo: string;
  actualizado: string;
}

const { titulo, actualizado } = Astro.props;
const inicio = import.meta.env.BASE_URL;
---

<Base title={`${titulo} — ${SITE.nombre}`} description={`${titulo} de ${SITE.nombre}.`} noindex>
  <header class="bg-navy">
    <div class="mx-auto flex max-w-3xl items-center justify-between px-6 py-6">
      <a href={inicio} aria-label={SITE.nombre}>
        <Logo name="horizontal-blanco" acento class="h-9 w-auto" />
      </a>
      <a href={inicio} class="text-sm text-grey transition-colors hover:text-bone">
        ← Volver
      </a>
    </div>
  </header>

  <main id="contenido" class="mx-auto max-w-3xl px-6 py-16 sm:py-24">
    <h1 class="titular text-3xl sm:text-4xl">{titulo}</h1>
    <p class="mt-3 text-sm text-slate-500">Última actualización: {actualizado}</p>

    <div
      class="mt-12 space-y-5 leading-relaxed text-slate-600 [&_a]:text-blue-ink [&_a]:underline [&_h2]:mt-12 [&_h2]:font-display [&_h2]:text-xl [&_h2]:font-normal [&_h2]:text-navy [&_li]:ml-5 [&_li]:list-disc [&_strong]:text-navy [&_ul]:space-y-2"
    >
      <slot />
    </div>
  </main>

  <Footer />
</Base>
